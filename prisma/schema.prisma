generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String
  onlineId     String?  @unique
  dateOfBirth  DateTime?
  kycStatus    String   @default("pending")
  profileType  String   @default("individual")
  kycData      String?
  ambassadorId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  nonprofitProfile       NonprofitProfile?
  accounts               PortfolioAccount[]
  transactions           Transaction[]
  sessions               Session[]
  withdrawalRequests     WithdrawalRequest[]
  investmentAgreements   InvestmentAgreement[]
  notifications          UserNotification[]
  birthdayWishes         BirthdayWish[]
  kycDocumentRequests    KycDocumentRequest[]
  ambassador             BrandAmbassador? @relation(fields: [ambassadorId], references: [id], onDelete: SetNull)

  @@index([ambassadorId])
  @@index([dateOfBirth])
}

model NonprofitProfile {
  id                    String @id @default(cuid())
  userId                String @unique
  user                  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationLegalName String
  dbaName               String?
  ein                   String
  organizationType      String
  yearEstablished       String
  missionStatement      String
  website               String?
  fundCapital           Float
  monthlyRate           Float
  representativeName    String
  representativeTitle   String
}

model PortfolioAccount {
  id                 String    @id
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountNumber      String
  type               String
  principal          Float
  monthlyRatePercent Float
  investmentPlanId   String?
  maturityDate       DateTime?
  status             String    @default("active")
  profitEligibleAt   DateTime?
  profitRateAmended  Boolean   @default(false)
  amendmentNote      String?
  createdAt          DateTime  @default(now())
  /** July promo $50k sheet: admin-started daily 0.5% compounding */
  dailyCompoundActive    Boolean   @default(false)
  dailyCompoundStartDate DateTime?
  dailyCompoundEndDate   DateTime?
  dailyCompoundRatePercent Float   @default(0.5)

  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id          String           @id
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   String
  account     PortfolioAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type        String
  amount      Float
  description String
  status      String           @default("completed")
  date        DateTime         @default(now())

  @@index([userId])
  @@index([accountId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model ContactMessage {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String
  phone     String?
  topic     String
  message   String
  createdAt DateTime @default(now())
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  listType  String
  email     String
  createdAt DateTime @default(now())

  @@unique([listType, email])
  @@index([listType])
}

model AppointmentRequest {
  id            String   @id @default(cuid())
  fullName      String
  phone         String?
  email         String
  preferredDate String?
  topic         String
  createdAt     DateTime @default(now())
}

model WithdrawalRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String
  amount    Float
  method    String
  reference String
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@index([userId])
}

model InvestmentAgreement {
  id                 String   @id @default(cuid())
  agreementNumber    String   @unique
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId          String
  transactionId      String   @unique
  planId             String
  planName           String
  monthlyRatePercent Float
  termMonths         Int
  totalRoiPercent    Float
  depositAmount      Float
  totalPrincipal     Float
  accountNumber      String
  accountType        String
  issuedAt           DateTime @default(now())
  maturityDate       DateTime
  clientFirstName    String
  clientLastName     String
  clientEmail        String
  amendedAt          DateTime?
  amendmentNote      String?

  @@index([userId])
  @@index([accountId])
}

model NotificationBroadcast {
  id               String             @id @default(cuid())
  title            String
  message          String
  type             String             @default("info")
  scope            String
  recipientCount   Int
  durationDays     Int                @default(0)
  durationHours    Int                @default(0)
  expiresAt        DateTime
  adminId          String?
  /** Set when a brand ambassador sends to their referred clients */
  ambassadorId     String?
  createdAt        DateTime           @default(now())
  notifications    UserNotification[]

  @@index([createdAt])
  @@index([expiresAt])
  @@index([ambassadorId])
}

model UserNotification {
  id          String                 @id @default(cuid())
  userId      String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  broadcastId String?
  broadcast   NotificationBroadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)
  title       String
  message     String
  type        String                 @default("info")
  readAt      DateTime?
  expiresAt   DateTime
  createdAt   DateTime               @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([userId, expiresAt])
}

model BirthdayWish {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year           Int
  emailSent      Boolean  @default(false)
  notificationId String?
  createdAt      DateTime @default(now())

  @@unique([userId, year])
  @@index([year])
}

model KycDocumentRequest {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentKey    String
  adminNote      String?
  status         String    @default("pending")
  adminId        String?
  notificationId String?
  requestedAt    DateTime  @default(now())
  fulfilledAt    DateTime?

  @@index([userId, status])
  @@index([status, requestedAt])
}

model SignupAttemptLog {
  id           String   @id @default(cuid())
  profileType  String
  status       String
  email        String?
  onlineId     String?
  firstName    String?
  lastName     String?
  orgName      String?
  errorMessage String?
  errorCode    String?
  source       String   @default("server")
  ipAddress    String?
  userAgent    String?
  payloadKb    Int?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([status])
  @@index([profileType])
}

model Admin {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  role         String         @default("admin")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
  chats        ChatConversation[] @relation("AssignedAdmin")
}

model AdminSession {
  id        String   @id @default(cuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([token])
}

model ChatConversation {
  id              String        @id @default(cuid())
  visitorName     String
  visitorEmail    String
  userId          String?
  visitorIp       String?
  visitorCity     String?
  visitorRegion   String?
  visitorCountry  String?
  visitorLocation String?
  lastSeenAt      DateTime?
  humanTakeoverAt DateTime?
  status          String        @default("open")
  assignedToId    String?
  assignedTo      Admin?        @relation("AssignedAdmin", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  messages        ChatMessage[]

  @@index([status])
  @@index([updatedAt])
  @@index([lastSeenAt])
}

model VisitorPresence {
  id             String   @id @default(cuid())
  sessionToken   String   @unique
  userId         String?
  visitorName    String?
  visitorEmail   String?
  conversationId String?
  currentPath    String   @default("/")
  ipAddress      String?
  city           String?
  region         String?
  country        String?
  locationLabel  String?
  status         String   @default("website")
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([status, lastSeenAt])
  @@index([lastSeenAt])
}

/** Durable site visitor identity (cookie session) — visit history for admin */
model SiteVisitor {
  id            String         @id @default(cuid())
  sessionToken  String         @unique
  visitCount    Int            @default(0)
  firstSeenAt   DateTime       @default(now())
  lastSeenAt    DateTime       @default(now())
  lastIp        String?
  lastCity      String?
  lastRegion    String?
  lastCountry   String?
  lastLatitude  Float?
  lastLongitude Float?
  lastLocation  String?
  lastUserAgent String?
  lastPath      String?
  userId        String?
  visits        SiteVisit[]
  pageViews     SitePageView[]

  @@index([lastSeenAt])
  @@index([lastIp])
  @@index([visitCount])
}

/** One browsing session (new visit after 30+ min idle) */
model SiteVisit {
  id            String         @id @default(cuid())
  visitorId     String
  visitor       SiteVisitor    @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  startedAt     DateTime       @default(now())
  endedAt       DateTime       @default(now())
  durationMs    Int            @default(0)
  entryPath     String         @default("/")
  exitPath      String?
  ipAddress     String?
  city          String?
  region        String?
  country       String?
  latitude      Float?
  longitude     Float?
  locationLabel String?
  userAgent     String?
  referrer      String?
  pageViews     SitePageView[]

  @@index([visitorId, startedAt])
  @@index([startedAt])
  @@index([ipAddress])
}

/** Per-page stay within a visit */
model SitePageView {
  id         String      @id @default(cuid())
  visitorId  String
  visitor    SiteVisitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  visitId    String
  visit      SiteVisit   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  path       String
  title      String?
  enteredAt  DateTime    @default(now())
  leftAt     DateTime?
  durationMs Int         @default(0)
  ipAddress  String?
  city       String?
  region     String?
  country    String?
  latitude   Float?
  longitude  Float?

  @@index([visitorId, enteredAt])
  @@index([visitId, enteredAt])
  @@index([path, enteredAt])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     String
  senderName     String
  body           String
  createdAt      DateTime         @default(now())
  readAt         DateTime?

  @@index([conversationId])
  @@index([createdAt])
}

model BrandAmbassadorApplication {
  id         String           @id @default(cuid())
  firstName  String
  lastName   String
  email      String
  phone      String
  city       String?
  state      String?
  linkedin   String?
  experience String?
  message    String
  status     String           @default("pending")
  reviewNote String?
  reviewedAt DateTime?
  createdAt  DateTime         @default(now())
  ambassador BrandAmbassador?

  @@index([status, createdAt])
  @@index([email])
}

model BrandAmbassador {
  id            String                     @id @default(cuid())
  applicationId String?                    @unique
  application   BrandAmbassadorApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  username      String                      @unique
  email         String                      @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String
  referralCode  String                      @unique
  /** Admin-assigned commission % of each referred client's first approved deposit */
  commissionRatePercent Float               @default(3)
  status        String                      @default("active")
  approvedAt    DateTime                    @default(now())
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  sessions      ManagerSession[]
  referrals     User[]

  @@index([referralCode])
  @@index([status])
}

model ManagerSession {
  id           String          @id @default(cuid())
  ambassadorId String
  ambassador   BrandAmbassador @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)
  token        String          @unique
  expiresAt    DateTime
  createdAt    DateTime        @default(now())

  @@index([ambassadorId])
  @@index([token])
}

/** Singleton site-wide Wealth Accelerator FD promotion (admin-managed) */
model FdPromoConfig {
  id               String   @id @default("default")
  isActive         Boolean  @default(true)
  /** Display calendar month 1–12 (drives “July / August …” labels) */
  displayMonth     Int
  displayYear      Int
  /** Enrollment cutoff — admin can extend past calendar month end */
  endsAt           DateTime
  minDeposit       Float    @default(50000)
  returnPercent    Float    @default(90)
  termMonths       Int      @default(6)
  planId           String   @default("july-promo-fd")
  packageName      String?
  headline         String?
  subheadline      String?
  updatedByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
